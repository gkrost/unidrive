{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "unidrive config.toml",
  "description": "Mirrors RawGeneral and RawProvider in core/app/sync/.../SyncConfig.kt. A test keeps the property names in lockstep.",
  "type": "object",
  "properties": {
    "general": {
      "type": "object",
      "properties": {
        "default_profile": { "type": "string" },
        "sync_root": { "type": "string" },
        "poll_interval": { "type": "integer" },
        "min_poll_interval": { "type": "integer" },
        "max_poll_interval": { "type": "integer" },
        "conflict_policy": { "type": "string", "enum": ["keep_both", "last_writer_wins"] },
        "log_file": { "type": "string" },
        "max_bandwidth_kbps": { "type": "integer" },
        "max_delete_percentage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_delete_absolute": { "type": "integer", "minimum": 0 },
        "max_delete_per_subtree_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "sync_direction": { "type": "string", "enum": ["bidirectional", "upload", "download"] },
        "client_location": { "type": "string" },
        "client_network": { "type": "string" },
        "exclude_patterns": { "type": "array", "items": { "type": "string" } },
        "desktop_notifications": { "type": "boolean" },
        "verify_integrity": { "type": "boolean" },
        "use_trash": { "type": "boolean" },
        "trash_emulation": { "type": "boolean" },
        "trash_retention_days": { "type": "integer", "minimum": 1 },
        "file_versioning": { "type": "boolean" },
        "max_versions": { "type": "integer", "minimum": 1 },
        "version_retention_days": { "type": "integer", "minimum": 1 },
        "streaming_reconciliation": { "type": "boolean" }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "sync_root": { "type": "string" },
          "root_path": { "type": "string" },
          "pin_patterns": {
            "type": "object",
            "properties": {
              "include": { "type": "array", "items": { "type": "string" } },
              "exclude": { "type": "array", "items": { "type": "string" } }
            }
          },
          "conflict_overrides": { "type": "object", "additionalProperties": { "type": "string" } },
          "exclude_patterns": { "type": "array", "items": { "type": "string" } },
          "sync_path": {
            "description": "Remote subtree(s) this profile syncs. Absolute remote paths starting with '/'. Absent means the whole drive. The CLI --sync-path overrides it for one invocation.",
            "oneOf": [
              { "type": "string", "pattern": "^/" },
              { "type": "array", "items": { "type": "string", "pattern": "^/" } }
            ]
          },
          "hydration_cache_max_bytes": {
            "description": "Budget of this profile's hydration cache in bytes (the copies reads and writes through the mount leave under ~/.cache/unidrive/hydration/<profile>). Least recently used copies that hold nothing the cloud or the sync root does not are evicted after each close, after each upload and at daemon start. 0 means unlimited. Default 21474836480 (20 GiB).",
            "type": "integer",
            "minimum": 0
          },
          "sync_root_rescan_minutes": {
            "description": "How often the daemon rescans the sync root for files that arrived there other than through the mount (copied in, dropped while the daemon was stopped, restored from a backup) and uploads them, in minutes. One pass also runs at daemon start. Upload-only: never downloads or deletes. 0 turns it off. Default 10.",
            "type": "integer",
            "minimum": 0
          },
          "daemon_poll_seconds": {
            "description": "How often `unidrive daemon run` polls the cloud for changes made elsewhere (web UI, another device, another profile on the same account), in seconds. The first poll runs at daemon start; after a provider failure the interval backs off (up to 10 min). Each poll is an incremental delta from the stored cursor. 0 turns polling off. Default 60. `daemon run --poll-interval` overrides it.",
            "type": "integer",
            "minimum": 0
          },
          "bucket": { "type": "string" },
          "region": { "type": "string" },
          "endpoint": { "type": "string" },
          "access_key_id": { "type": "string" },
          "secret_access_key": { "type": "string" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "user": { "type": "string" },
          "remote_path": { "type": "string" },
          "identity": { "type": "string" },
          "password": { "type": "string" },
          "url": { "type": "string" },
          "client_id": { "type": "string" },
          "client_secret": { "type": "string" },
          "authority_url": { "type": "string" },
          "include_shared": { "type": "boolean" },
          "webhook": { "type": "boolean" },
          "webhook_port": { "type": "integer" },
          "webhook_url": { "type": "string" },
          "trust_all_certs": { "type": "boolean" },
          "rclone_remote": { "type": "string" },
          "rclone_path": { "type": "string" },
          "rclone_binary": { "type": "string" },
          "rclone_config": { "type": "string" },
          "fast_bootstrap": { "type": "boolean" },
          "keep_overwritten": { "type": "boolean" }
        }
      }
    }
  }
}
